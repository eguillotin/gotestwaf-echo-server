+package placeholder
+
+import (
+	"testing"
+
+	"github.com/wallarm/gotestwaf/internal/payload/encoder"
+	"github.com/wallarm/gotestwaf/internal/scanner/types"
+)
+
+// The GraphQL GET placeholder must place the already-encoded payload into the
+// query string verbatim. A test case that uses `encoder: URL` (e.g.
+// testcases/owasp-api/graphql.yml) has already URL-encoded the payload by the
+// time it reaches the placeholder, so re-encoding it here double-encodes it —
+// inconsistent with the URLPath/URLParam placeholders, which concatenate the
+// encoded payload directly.
+func TestGraphQLGetDoesNotDoubleEncode(t *testing.T) {
+	const raw = `<script>alert(1)</script>`
+
+	// Stage 1 of the pipeline: the test case's URL encoder runs first.
+	encoded, err := encoder.Apply(encoder.DefaultURLEncoder.GetName(), raw)
+	if err != nil {
+		t.Fatalf("encoder.Apply: %v", err)
+	}
+
+	conf, err := DefaultGraphQL.NewPlaceholderConfig(map[any]any{"method": "GET"})
+	if err != nil {
+		t.Fatalf("NewPlaceholderConfig: %v", err)
+	}
+
+	// Stage 2: the placeholder places the already-encoded payload.
+	req, err := DefaultGraphQL.CreateRequest("http://example.com/graphql", encoded, conf, types.GoHTTPClient)
+	if err != nil {
+		t.Fatalf("CreateRequest: %v", err)
+	}
+
+	httpReq, ok := req.(*types.GoHTTPRequest)
+	if !ok {
+		t.Fatalf("unexpected request type %T", req)
+	}
+
+	// Decoding the query parameter exactly once must yield the original payload.
+	// If it was double-encoded, one decode leaves it still URL-encoded.
+	got := httpReq.Req.URL.Query().Get("query")
+	if got != raw {
+		t.Errorf("GraphQL GET double-encoded the payload:\n got:  %q\n want: %q\n raw query string: %q",
+			got, raw, httpReq.Req.URL.RawQuery)
+	}
+}
